export PATH=$PATH:$HOME/appimages
export PATH=$PATH:/snap/bin
export PATH=$HOME/.local/bin:$PATH
export PATH=$HOME/.cargo/bin:$PATH
export PATH=$HOME/.local/go/bin:$PATH
export BUN_INSTALL="$HOME/.bun"
export PATH="$BUN_INSTALL/bin:$PATH"

# Use sccache when available; otherwise fall back to Cargo incremental builds.
# Keep the modes exclusive because sccache rejects forced incremental builds.
if command -v sccache >/dev/null 2>&1; then
  export RUSTC_WRAPPER=sccache
  export SCCACHE_DIR="$HOME/.cache/sccache"
  export SCCACHE_CACHE_SIZE=20G
  unset CARGO_INCREMENTAL
else
  export CARGO_INCREMENTAL=1
fi

if [ -f "$HOME/.ssh-agent-start.sh" ]; then
  . "$HOME/.ssh-agent-start.sh"
fi

# source machine specific config
if [ -f $HOME/.posixrc.local ]; then
  source $HOME/.posixrc.local
fi

# source nvm (for node.js)
if [ -f $HOME/.nvm/nvm.sh ]; then
  source $HOME/.nvm/nvm.sh
fi

# for cline llm agent
if [ "$CLINE_ACTIVE" = "true" ]; then
  export PAGER=cat
fi
